<!doctype html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Real-Time AI Video & Voice' }) %>
</head>
<body>
<%- include('partials/public-nav') %>

<main id="home">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-copy">
        <span class="eyebrow">Real-time AI platform</span>
        <h1>Real-Time AI, Built for Human Connection.</h1>
        <p>Folklore gives you AI-powered real-time video and voice experiences in one platform —
          simple to start, priced with transparent, credit-based usage.</p>
        <div class="hero-ctas">
          <a href="/signup" class="btn btn-primary">Get Started</a>
          <a href="#about" class="btn btn-secondary">Explore Folklore</a>
        </div>
        <div class="trust-strip">
          <span>Real-time video</span>
          <span>Real-time voice changer</span>
          <span>Credit-based usage</span>
          <span>Usage tracking built in</span>
        </div>
      </div>
      <div class="hero-visual">
        <img src="/img/hero-visual.svg" alt="Abstract visual of real-time AI video and voice connection" />
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <div class="container about-grid">
      <div class="hero-visual">
        <img src="/img/visual-tech.svg" alt="Abstract neural network visual representing Folklore's AI layer" />
      </div>
      <div>
        <span class="eyebrow">About Folklore</span>
        <h2 class="section-heading">One platform for real-time AI connection</h2>
        <p class="section-sub">Folklore brings real-time video and real-time voice transformation together in a
          single, credit-based platform — so you can start an AI-powered session in seconds, without
          juggling separate tools or subscriptions.</p>
        <div class="about-points">
          <div class="about-point">
            <span class="dot"></span>
            <div>
              <h4>What Folklore is</h4>
              <p>A focused platform for real-time, AI-assisted video and voice experiences — built to feel instant, not batch-processed.</p>
            </div>
          </div>
          <div class="about-point">
            <span class="dot"></span>
            <div>
              <h4>The problem it solves</h4>
              <p>Real-time media tools are usually scattered across different apps with confusing pricing. Folklore unifies them behind one simple credit balance.</p>
            </div>
          </div>
          <div class="about-point">
            <span class="dot"></span>
            <div>
              <h4>Why real-time matters</h4>
              <p>Video and voice transformation are only useful if they happen live — during the conversation, not after it. Folklore is built around that constraint.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Features</span>
        <h2 class="section-heading">Everything you need to go live</h2>
        <p class="section-sub">A small set of focused features, each backed by the same credit system.</p>
      </div>

      <div class="features-grid">
        <div class="card feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="14" height="12" rx="2"/><path d="M16 10l6-3v10l-6-3"/></svg>
          </div>
          <h3>Real-Time Video</h3>
          <p>AI-powered real-time video experiences with simple, credit-based usage.</p>
        </div>

        <div class="card feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 003-3V6a3 3 0 00-6 0v6a3 3 0 003 3z"/><path d="M19 11a7 7 0 01-14 0"/><line x1="12" y1="18" x2="12" y2="22"/></svg>
          </div>
          <h3>Real-Time Voice Changer</h3>
          <p>Transform your voice in real time while using the platform.</p>
        </div>

        <div class="card feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12h6M12 9v6"/></svg>
          </div>
          <h3>Credit-Based Usage</h3>
          <p>Purchase credits and use them across every supported real-time feature.</p>
        </div>

        <div class="card feature-card">
          <div class="feature-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>
          </div>
          <h3>Usage Tracking</h3>
          <p>See exactly how many credits you've used and how many remain, at any time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 class="section-heading">Three steps to your first session</h2>
      </div>

      <div class="steps-grid">
        <div class="step">
          <span class="step-number">01</span>
          <h3>Create Your Account</h3>
          <p>Sign up and access the Folklore platform.</p>
          <span class="step-arrow">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
        <div class="step">
          <span class="step-number">02</span>
          <h3>Get Credits</h3>
          <p>Purchase credits for real-time video and voice features.</p>
          <span class="step-arrow">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
        <div class="step">
          <span class="step-number">03</span>
          <h3>Create &amp; Connect</h3>
          <p>Use real-time video and voice features while tracking your usage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2 class="section-heading">Simple, credit-based pricing</h2>
        <p class="section-sub">Buy credits for the features you use. No subscriptions, no surprise fees.</p>
      </div>

      <div class="pricing-grid">
        <div class="card price-card">
          <span class="badge badge-brand">Real-Time Video</span>
          <div class="price">$20<span> / credit package</span></div>
          <p class="desc">Credits for AI-powered real-time video sessions.</p>
          <a href="<%= isAuthenticated ? '/credits' : '/signin?next=%2Fcredits' %>" class="btn btn-primary btn-block">Get Video Credits</a>
        </div>
        <div class="card price-card">
          <span class="badge badge-brand">Real-Time Voice Changer</span>
          <div class="price">$10<span> / credit package</span></div>
          <p class="desc">Credits for real-time voice transformation sessions.</p>
          <a href="<%= isAuthenticated ? '/credits' : '/signin?next=%2Fcredits' %>" class="btn btn-primary btn-block">Get Voice Credits</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<script src="/js/site.js"></script>
</body>
</html>
