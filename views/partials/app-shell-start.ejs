<div class="app-shell">
  <aside class="app-sidebar">
    <a href="/dashboard" class="brand-mark">
      <img src="/img/logo-mark.svg" alt="" />
      Folklore
    </a>
    <%- include('side-nav-items', { active: active }) %>
    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="avatar"><%= user.name.charAt(0) %></div>
        <div class="who">
          <strong><%= user.name %></strong>
          <span><%= user.email %></span>
        </div>
      </div>
      <form method="post" action="/signout">
        <button type="submit" class="btn btn-secondary btn-block btn-sm">Sign Out</button>
      </form>
    </div>
  </aside>

  <div class="app-drawer" id="app-drawer">
    <div class="drawer-backdrop" id="drawer-backdrop"></div>
    <div class="drawer-panel">
      <a href="/dashboard" class="brand-mark" style="margin-bottom:20px;">
        <img src="/img/logo-mark.svg" alt="" />
        Folklore
      </a>
      <%- include('side-nav-items', { active: active }) %>
      <div class="sidebar-footer">
        <form method="post" action="/signout">
          <button type="submit" class="btn btn-secondary btn-block btn-sm">Sign Out</button>
        </form>
      </div>
    </div>
  </div>

  <div class="app-main">
    <div class="app-topbar">
      <a href="/dashboard" class="brand-mark">
        <img src="/img/logo-mark.svg" alt="" />
        Folklore
      </a>
      <button class="nav-toggle" id="drawer-toggle" type="button" aria-label="Open menu" aria-expanded="false">
