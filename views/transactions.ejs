<!doctype html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Transaction History' }) %>
</head>
<body>
<%- include('partials/app-shell-start', { active: 'transactions', user: user }) %>

  <div class="page-head">
    <div>
      <h1>Transaction History</h1>
      <p>A complete record of your Folklore credit purchases.</p>
    </div>
  </div>

  <div class="card">
    <% if (!transactions.length) { %>
      <div class="state-block">
        <h3>No transactions yet</h3>
        <p>Your purchase history will appear here.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date &amp; Time</th>
              <th>Description</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Reference</th>
            </tr>
          </thead>
          <tbody>
            <% transactions.slice().reverse().forEach(function(t) { %>
              <tr>
                <td><%= formatDateTime(t.occurredAt) %></td>
                <td><%= t.description %></td>
                <td><%= formatMoney(t.amount) %></td>
                <td><span class="badge badge-success"><%= t.status %></span></td>
                <td class="mono"><%= t.referenceId %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<%- include('partials/app-shell-end') %>
</body>
</html>
